# Copy this file to `.env` and fill in the two values from your Supabase project.
# Step-by-step instructions are in SUPABASE_SETUP.md.
#
# The site runs fine without them (login just stays switched off).
# After editing `.env`, stop the dev server (Ctrl+C) and run `npm run dev` again.

# Project URL, for example https://abcdxyz.supabase.co
VITE_SUPABASE_URL=

# The public "publishable" key (starts with sb_publishable_).
# NEVER put a "secret" or "service_role" key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
